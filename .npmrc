# @capgo/native-purchases@7.x declares a peer dep on @capacitor/core >=7,
# but SideCut runs Capacitor 6 (whose core's registerPlugin API is identical —
# the v6 plugin line consumes every purchased in-app product on every restore,
# which would silently delete the lifetime SKU, so we must use the 7.x code）。
# The peer wall is advisory only — force npm to install anyway.
legacy-peer-deps=true